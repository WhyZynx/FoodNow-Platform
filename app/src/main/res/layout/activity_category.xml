<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="3dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            app:contentInsetStart="12dp"
            app:contentInsetStartWithNavigation="0dp"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/TextAppearance.Widget.AppCompat.Toolbar.Title" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khám phá món ngon"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tìm nhà hàng yêu thích của bà"
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/text_size_small" />

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_marginTop="13dp"
            android:background="@color/colorPrimary" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryRestaurants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="20dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmptyCategory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/search"
            android:drawablePadding="18dp"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Chưa có nhà hàng trong danh mục này&#10;&#10;Bà thử chọn danh mục khác nhé!"
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/text_size_medium"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>